<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UnsplashApp.MainPage"
    Title="Unsplash Search">

    <VerticalStackLayout
    Padding="30,0"
    Spacing="25" >

        <Button
        Text="Settings"
        Clicked="OnSettingsClicked" />

        <Entry
        x:Name="SearchEntry"
        Placeholder="Enter something to search" />

        <Button
        Text="Search"
        Clicked="OnSearchClicked" />

        <Label
        x:Name="StatusLabel"
        Text="Enter a keyword and click Search" />

        <CollectionView
        x:Name="CollectionsView"
        HeightRequest="350">

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="5" Padding="5">

                        <Image
                        Source="{Binding CoverPhoto.Urls.Small}"
                        HeightRequest="150"
                        Aspect="AspectFill" />

                        <Label
                        Text="{Binding Title}"
                        FontSize="16" />

                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        
    </VerticalStackLayout>

</ContentPage>
