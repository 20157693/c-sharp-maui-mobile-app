<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UnsplashApp.MainPage"
    Title="Unsplash Search">

    <VerticalStackLayout
    Padding="30,0"
    Spacing="25" >

        <Label
        Text="Unsplash Photo Search"
        FontSize="24" />

        <Entry
        x:Name="SearchEntry"
        Placeholder="Enter something to search" />

        <Button
        Text="Search"
        Clicked="OnSearchClicked" />

        <Label
            x:Name="StatusLabel"
            Text="Enter a keyword and click Search" />
        
    </VerticalStackLayout>

</ContentPage>
