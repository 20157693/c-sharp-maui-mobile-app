<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UnsplashApp.Pages.SettingsPage"
    Title="SettingsPage">

    <VerticalStackLayout Padding="30" Spacing="20">

        <Label
            Text="Settings"
            FontSize="24" />

        <Label Text="Appearance" />
        <Picker x:Name="AppearancePicker">
            <Picker.Items>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </Picker.Items>
        </Picker>

        <Label Text="Images per Page" />
        <Picker x:Name="ImagesPicker">
            <Picker.Items>
                <x:String>5</x:String>
                <x:String>10</x:String>
                <x:String>15</x:String>
            </Picker.Items>
        </Picker>

        <Label Text="Collections per Page" />
        <Picker x:Name="CollectionsPicker">
            <Picker.Items>
                <x:String>1</x:String>
                <x:String>3</x:String>
                <x:String>5</x:String>
            </Picker.Items>
        </Picker>

        <Button Text="Home" Clicked="OnHomeClicked"/>

    </VerticalStackLayout>

</ContentPage>