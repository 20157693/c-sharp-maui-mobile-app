<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UnsplashApp.Pages.ResultsPage"
             Title="Search Results">

    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="10">

        <Label 
            x:Name="ResultsLabel"
            Grid.Row="0"
            Text="Waiting for search results..."
            FontSize="18" />

        <CollectionView
            x:Name="PhotosCollection"
            Grid.Row="1"
            SelectionMode="Single"
            SelectionChanged="OnPhotoSelected">
            <!--Be able to select only one photo at a time-->
            <!--Link Selection Change to Method-->
            <CollectionView.ItemTemplate>
                <!--Create a class for the template of each img-->
                <!--This is the template for each image, reused-->
                <DataTemplate>
                    <!--Impute Urls.Small to the image-->
                    <Image
                        Source="{Binding Urls.Small}"
                        HeightRequest="200"
                        Aspect="AspectFill"
                        Margin="0,5" />
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        
    </Grid>

</ContentPage>