<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UnsplashApp.Pages.PhotoDetailsPage"
    Title="PhotoDetailsPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label
                Text="Photo in Fullscreen"
                FontSize="24" />
            <!--Set fixed height at 350-->
            <!--Scale image proportionally to fit device screen-->
            <Image
                x:Name="SelectedPhotoImage"
                HeightRequest="350"
                Aspect="AspectFit" />

            <VerticalStackLayout Spacing="8">

                <Label Text="Photograph Details"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Label x:Name="PhotographerLabel" />
                <Label x:Name="ResolutionLabel" />
                <Label x:Name="CameraLabel" />
                <Label x:Name="ShutterLabel" />
                <Label x:Name="ApertureLabel" />
                <Label x:Name="IsoLabel" />
                <Label x:Name="FocalLengthLabel" />
                <Label x:Name="LocationLabel" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>