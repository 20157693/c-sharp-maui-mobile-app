<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="UnsplashApp.Pages.PhotoDetailsPage"
    Title="PhotoDetailsPage">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label
            Text="Photo in Fullscreen"
            FontSize="24" />
        <!--Set fixed height at 350-->
        <!--Scale image proportionally to fit device screen-->
        <Image
            x:Name="SelectedPhotoImage"
            HeightRequest="350"
            Aspect="AspectFit" />

        <Label
            x:Name="PhotoDescription"
            Text="Waiting for photograph..."
            FontSize="16" />

    </VerticalStackLayout>

</ContentPage>